{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longitude",
  "version": "0.1.1",
  "identifier": "app.longitude.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Longitude",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "preventOverflow": true,
        "theme": "Dark",
        "backgroundColor": "#07080A",
        "dragDropEnabled": false,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'", "'wasm-unsafe-eval'", "blob:", "http://vendor.localhost", "https://vendor.localhost", "vendor://localhost"],
        "worker-src": ["'self'", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:"],
        "font-src": ["'self'", "data:", "blob:"],
        "media-src": ["'self'", "data:", "blob:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "http://vendor.localhost",
          "https://vendor.localhost",
          "vendor://localhost",
          "https://huggingface.co",
          "https://*.huggingface.co",
          "https://*.hf.co",
          "https://cdn.jsdelivr.net",
          "https://api.github.com",
          "data:",
          "blob:"
        ],
        "manifest-src": ["'self'"],
        "frame-src": ["'none'"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"]
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/": "vendor/"
    },
    "fileAssociations": [
      {
        "ext": ["longitude"],
        "name": "Longitude.Design",
        "description": "Longitude design",
        "role": "Editor",
        "mimeType": "application/x-longitude"
      }
    ],
    "category": "GraphicsAndDesign",
    "license": "MIT",
    "licenseFile": "installer/license.txt",
    "shortDescription": "Thumbnails and covers, made on your computer",
    "longDescription": "A small, open-source editor for YouTube thumbnails and Spotify covers. Background removal runs on your computer and is included with the app.",
    "publisher": "zphat",
    "copyright": "Copyright (c) 2026 zphat",
    "homepage": "https://github.com/zphat/Longitude",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "languages": ["English"],
        "compression": "lzma"
      }
    }
  }
}
