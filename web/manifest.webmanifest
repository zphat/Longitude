{
  "id": "./",
  "name": "Longitude",
  "short_name": "Longitude",
  "description": "Make YouTube thumbnails and Spotify covers on your own computer. Free, open source, no account.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#090b0d",
  "theme_color": "#090b0d",
  "lang": "en",
  "categories": ["photo", "graphics", "productivity"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-longitude": [".longitude"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "image/avif": [".avif"],
        "image/bmp": [".bmp"],
        "image/svg+xml": [".svg"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
